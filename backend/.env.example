DATABASE_URL="postgresql://redrob:redrob_dev_password@localhost:5432/redrob_hrms?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
PORT=3001

# Auth Phase 1 — Super Admin seed password (see prisma/seed.ts). Set
# explicitly outside local dev.
SUPER_ADMIN_SEED_PASSWORD=

# Outbound email (invitations/activation/notifications) — see
# shared/email/email.service.ts. Leave unset to have emails logged instead
# of sent. For Gmail/Google Workspace: host smtp.gmail.com, port 587,
# SMTP_USER is the full mailbox address, SMTP_PASS is a Google App Password
# (not the account password — generate one at
# https://myaccount.google.com/apppasswords, requires 2-Step Verification).
# Never commit real values here.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
