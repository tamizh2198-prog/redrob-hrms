DATABASE_URL="postgresql://redrob:redrob_dev_password@localhost:5432/redrob_hrms?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
PORT=3001

# Auth Phase 1 — Super Admin seed password (see prisma/seed.ts). Set
# explicitly outside local dev.
SUPER_ADMIN_SEED_PASSWORD=

# Outbound email (invitations/activation/notifications) — see
# shared/email/email.service.ts. Leave unset to have emails logged instead
# of sent. Sent via Resend's HTTPS API, not SMTP — Railway blocks outbound
# SMTP (ports 25/465/587) below its Pro plan, so nodemailer/SMTP silently
# timed out in production regardless of credentials. Get an API key at
# https://resend.com/api-keys (verify your sending domain there first, or
# EMAIL_FROM will be rejected). Never commit real values here.
# RESEND_API_KEY=
# EMAIL_FROM=
