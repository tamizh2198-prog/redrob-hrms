// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Employee Management (Section 7.1)
// company_id is carried on every table from day one so multi-company support
// later is a filtering change, not a schema migration (Section 10).
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  // Pre-Day-1 state from offer-accept through Preboarding portal completion
  // (Section 7.7) — precedes ACTIVE_PROBATION, which starts once onboarding
  // is done and the employee is actually working.
  PREBOARDING
  ACTIVE
  ACTIVE_PROBATION
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id   String @id @default(uuid())
  name String

  employees    Employee[]
  departments  Department[]
  designations Designation[]
  grades       Grade[]
  locations    Location[]
  shifts       Shift[]
  leaveTypes   LeaveType[]

  jobRequisitions     JobRequisition[]
  onboardingTemplates OnboardingChecklistTemplate[]
}

model Department {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  code      String
  parentId  String?
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Department[] @relation("DepartmentHierarchy")
  isActive  Boolean      @default(true)

  employees Employee[]

  jobRequisitions     JobRequisition[]
  onboardingTemplates OnboardingChecklistTemplate[]

  @@unique([companyId, code])
}

model Designation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]

  @@unique([companyId, code])
}

model Grade {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]

  @@unique([companyId, code])
}

model Location {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]
  holidays  Holiday[]

  @@unique([companyId, code])
}

model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Employee Code is system-generated, unique, immutable once assigned
  // (Section 7.1 Business Rules) — application layer enforces immutability.
  employeeCode String @unique

  firstName     String
  lastName      String
  dob           DateTime?
  gender        Gender?
  personalEmail String?
  workEmail     String?   @unique
  phone         String?

  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  gradeId            String?
  grade              Grade?       @relation(fields: [gradeId], references: [id])
  locationId         String?
  location           Location?    @relation(fields: [locationId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?    @relation("ManagerReports", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports      Employee[]   @relation("ManagerReports")

  dateOfJoining  DateTime?
  employmentType EmploymentType?
  status         EmployeeStatus  @default(ACTIVE_PROBATION)

  // System role for RBAC (Section 6) — every employee is also a system user.
  role Role @default(EMPLOYEE)

  // Statutory / sensitive fields — masked in API responses per Section 7.1
  // Business Rules unless the requester is HR Admin, Super Admin, or self.
  pan               String?
  aadhaar           String?
  bankAccountNumber String?

  emergencyContactName  String?
  emergencyContactPhone String?

  documents      EmployeeDocument[]
  historyEntries EmployeeHistory[]
  changeRequests ProfileChangeRequest[]

  rosterEntries              RosterEntry[]
  hybridSchedules            EmployeeHybridSchedule[]
  shiftSwapRequestsRequested ShiftSwapRequest[]         @relation("SwapRequester")
  shiftSwapRequestsReceived  ShiftSwapRequest[]         @relation("SwapCounterpart")
  attendanceRecords          AttendanceRecord[]
  regularizationRequests     RegularizationRequest[]
  leaveBalances              LeaveBalance[]
  leaveApplications          LeaveApplication[]
  optionalHolidaySelections  OptionalHolidaySelection[]

  requisitionsAsHiringManager  JobRequisition[]        @relation("RequisitionHiringManager")
  interviewRoundsAsInterviewer InterviewRound[]        @relation("InterviewerRounds")
  onboardingChecklist          OnboardingChecklist?
  preboardingSubmissions       PreboardingSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([reportingManagerId])
}

model EmployeeDocument {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  docType    String
  fileRef    String
  expiryDate DateTime?
  uploadedBy String
  uploadedAt DateTime  @default(now())

  @@index([employeeId])
}

model EmployeeHistory {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  fieldChanged  String
  oldValue      String?
  newValue      String?
  changedBy     String
  changedAt     DateTime  @default(now())
  effectiveDate DateTime?

  @@index([employeeId])
}

// Employee-submitted profile changes never write directly to the master
// record (Section 7.1 Business Rules) — they land here for HR Admin review.
model ProfileChangeRequest {
  id              String              @id @default(uuid())
  employeeId      String
  employee        Employee            @relation(fields: [employeeId], references: [id])
  fieldName       String
  oldValue        String?
  newValue        String
  status          ChangeRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Shift & Roster Management (Section 7.4)
// ---------------------------------------------------------------------------

enum ShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
}

model Shift {
  id           String  @id @default(uuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  name         String
  // Stored as "HH:mm" — a scaffold-level simplification over full TZ-aware time handling.
  startTime    String
  endTime      String
  graceMinutes Int     @default(0)
  halfDayHours Float   @default(4.5)
  isNightShift Boolean @default(false)

  rosterEntries RosterEntry[]

  @@unique([companyId, name])
}

enum WorkMode {
  OFFICE
  WORK_FROM_HOME
}

model RosterEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  date       DateTime
  isWeekOff  Boolean  @default(false)
  workMode   WorkMode @default(OFFICE)

  @@unique([employeeId, date])
  @@index([employeeId])
}

// Hybrid work culture (Section 7.4): each employee has their own office
// weekdays, assigned by HR per month — not a single company-wide pattern,
// since different employees/teams come in on different days.
model EmployeeHybridSchedule {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  year           Int
  month          Int
  officeWeekdays Int[]

  @@unique([employeeId, year, month])
}

model ShiftSwapRequest {
  id            String          @id @default(uuid())
  requesterId   String
  requester     Employee        @relation("SwapRequester", fields: [requesterId], references: [id])
  counterpartId String
  counterpart   Employee        @relation("SwapCounterpart", fields: [counterpartId], references: [id])
  date          DateTime
  status        ShiftSwapStatus @default(PENDING)
  approverId    String?
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Holiday Calendar (Section 7.5)
// ---------------------------------------------------------------------------

model Holiday {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  year       Int
  date       DateTime
  name       String
  isOptional Boolean  @default(false)

  optionalSelections OptionalHolidaySelection[]

  @@unique([locationId, date])
  @@index([locationId, year])
}

model OptionalHolidaySelection {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  holidayId  String
  holiday    Holiday  @relation(fields: [holidayId], references: [id])
  selectedAt DateTime @default(now())

  @@unique([employeeId, holidayId])
}

// ---------------------------------------------------------------------------
// Attendance Management (Section 7.2)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  EARLY_EXIT
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  WFH
}

enum AttendanceSource {
  BIOMETRIC
  WEB
  MOBILE
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRecord {
  id            String            @id @default(uuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id])
  date          DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  source        AttendanceSource?
  status        AttendanceStatus  @default(ABSENT)
  workHours     Float?
  overtimeHours Float?
  isLocked      Boolean           @default(false)

  @@unique([employeeId, date])
  @@index([employeeId])
}

model RegularizationRequest {
  id              String               @id @default(uuid())
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id])
  date            DateTime
  requestedStatus AttendanceStatus
  reason          String
  evidenceRef     String?
  approverId      String?
  status          RegularizationStatus @default(PENDING)
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Leave Management (Section 7.3)
// ---------------------------------------------------------------------------

enum LeaveAccrualFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model LeaveType {
  id                        String                @id @default(uuid())
  companyId                 String
  company                   Company               @relation(fields: [companyId], references: [id])
  name                      String
  // Short reference code (e.g. "EL", "SL", "CL") shown alongside the name,
  // consistent with the code convention on Department/Designation/Grade.
  code                      String?
  accrualFrequency          LeaveAccrualFrequency @default(MONTHLY)
  accrualRate               Float                 @default(0)
  maxCarryForward           Float                 @default(0)
  isEncashable              Boolean               @default(false)
  requiresDocumentAfterDays Int?
  allowsNegativeBalance     Boolean               @default(false)

  balances     LeaveBalance[]
  applications LeaveApplication[]

  @@unique([companyId, name])
}

model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  openingBalance Float     @default(0)
  accrued        Float     @default(0)
  used           Float     @default(0)
  carriedForward Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveApplication {
  id                String                 @id @default(uuid())
  employeeId        String
  employee          Employee               @relation(fields: [employeeId], references: [id])
  leaveTypeId       String
  leaveType         LeaveType              @relation(fields: [leaveTypeId], references: [id])
  startDate         DateTime
  endDate           DateTime
  daysCount         Float
  reason            String?
  status            LeaveApplicationStatus @default(PENDING)
  currentApproverId String?

  approvalSteps LeaveApprovalStep[]

  createdAt DateTime @default(now())

  @@index([employeeId])
}

model LeaveApprovalStep {
  id            String           @id @default(uuid())
  applicationId String
  application   LeaveApplication @relation(fields: [applicationId], references: [id])
  approverId    String
  sequence      Int
  decision      ApprovalDecision @default(PENDING)
  decidedAt     DateTime?
  comment       String?
}

// ---------------------------------------------------------------------------
// Recruitment & Applicant Tracking System (Section 7.6)
// ---------------------------------------------------------------------------

enum RequisitionStatus {
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ON_HOLD
  FILLED
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model JobRequisition {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  title           String
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])
  hiringManagerId String
  hiringManager   Employee          @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [id])
  headcount       Int               @default(1)
  status          RequisitionStatus @default(PENDING_APPROVAL)
  approvedBy      String?
  approvedAt      DateTime?
  budgetCtc       Float?
  createdAt       DateTime          @default(now())

  candidates Candidate[]

  @@index([companyId])
}

// Duplicate detection (Section 7.6 Business Rules: "same email/phone within
// 12 months are flagged, not silently created") self-links to the earlier
// record rather than blocking creation.
model Candidate {
  id            String         @id @default(uuid())
  requisitionId String
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id])
  name          String
  email         String
  phone         String?
  resumeRef     String?
  source        String?
  currentStage  CandidateStage @default(APPLIED)
  duplicateOfId String?
  duplicateOf   Candidate?     @relation("CandidateDuplicate", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates    Candidate[]    @relation("CandidateDuplicate")
  appliedAt     DateTime       @default(now())

  interviewRounds InterviewRound[]
  offers          Offer[]

  @@index([requisitionId])
  @@index([email])
}

model InterviewRound {
  id             String    @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  interviewerId  String
  interviewer    Employee  @relation("InterviewerRounds", fields: [interviewerId], references: [id])
  scheduledAt    DateTime
  scorecardJson  Json?
  recommendation String?
  completedAt    DateTime?

  @@index([candidateId])
}

model Offer {
  id             String      @id @default(uuid())
  candidateId    String
  candidate      Candidate   @relation(fields: [candidateId], references: [id])
  ctcBreakupJson Json
  status         OfferStatus @default(DRAFT)

  // Business Rule: "requires sign-off from Hiring Manager + HR Admin before
  // the letter is generated/sent" — two independent approvals, not a chain.
  hiringManagerApprovedBy String?
  hiringManagerApprovedAt DateTime?
  hrApprovedBy            String?
  hrApprovedAt            DateTime?

  sentAt            DateTime?
  acceptedAt        DateTime?
  docRef            String?
  createdEmployeeId String?

  createdAt DateTime @default(now())

  @@index([candidateId])
}

// ---------------------------------------------------------------------------
// Onboarding & Preboarding (Section 7.7)
// ---------------------------------------------------------------------------

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ChecklistTaskStatus {
  PENDING
  COMPLETED
}

enum ChecklistOwnerRole {
  HR
  IT
  MANAGER
  NEW_HIRE
}

// Versioned per Section 7.7 Business Rules ("changing a template doesn't
// retroactively alter checklists already in progress") — OnboardingChecklist
// snapshots templateId at creation and is never re-pointed at a newer version.
model OnboardingChecklistTemplate {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  version      Int         @default(1)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  taskTemplates ChecklistTaskTemplate[]
  checklists    OnboardingChecklist[]
}

model ChecklistTaskTemplate {
  id            String                      @id @default(uuid())
  templateId    String
  template      OnboardingChecklistTemplate @relation(fields: [templateId], references: [id])
  ownerRole     ChecklistOwnerRole
  description   String
  dueOffsetDays Int                         @default(0)

  @@index([templateId])
}

model OnboardingChecklist {
  id         String                      @id @default(uuid())
  employeeId String                      @unique
  employee   Employee                    @relation(fields: [employeeId], references: [id])
  templateId String
  template   OnboardingChecklistTemplate @relation(fields: [templateId], references: [id])
  status     ChecklistStatus             @default(NOT_STARTED)
  createdAt  DateTime                    @default(now())

  tasks ChecklistTask[]
}

model ChecklistTask {
  id          String              @id @default(uuid())
  checklistId String
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id])
  ownerRole   ChecklistOwnerRole
  description String
  dueDate     DateTime?
  status      ChecklistTaskStatus @default(PENDING)
  completedBy String?
  completedAt DateTime?

  @@index([checklistId])
}

model PreboardingSubmission {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  fieldType   String
  valueRef    String
  verifiedBy  String?
  verifiedAt  DateTime?
  submittedAt DateTime  @default(now())

  @@index([employeeId])
}
