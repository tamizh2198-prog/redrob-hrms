// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Employee Management (Section 7.1)
// company_id is carried on every table from day one so multi-company support
// later is a filtering change, not a schema migration (Section 10).
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  // Auth Phase 2: account created by an admin, invitation email sent, no
  // password set yet — distinct from PREBOARDING (Section 7.7's post-offer,
  // pre-Day-1 flow), which is about onboarding-task completion, not login
  // credentials. INVITED -> ACTIVE once the employee sets a password.
  INVITED
  // Pre-Day-1 state from offer-accept through Preboarding portal completion
  // (Section 7.7) — precedes ACTIVE_PROBATION, which starts once onboarding
  // is done and the employee is actually working.
  PREBOARDING
  ACTIVE
  ACTIVE_PROBATION
  ON_LEAVE
  INACTIVE
  TERMINATED
  // Section 7.10 Business Rule: set only once Full & Final settlement is
  // marked paid — a minimal historical record kept for rehire-eligibility
  // checks, not a full employee record anymore.
  ARCHIVED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id   String @id @default(uuid())
  name String

  employees    Employee[]
  departments  Department[]
  designations Designation[]
  grades       Grade[]
  locations    Location[]
  shifts       Shift[]
  leaveTypes   LeaveType[]

  jobRequisitions     JobRequisition[]
  onboardingTemplates OnboardingChecklistTemplate[]
  offerTemplates      OfferTemplate[]

  reviewCycles ReviewCycle[]
  assets       Asset[]

  ticketSlaPolicies TicketSlaPolicy[]
  faqEntries        FaqEntry[]

  announcements Announcement[]

  policyDocuments PolicyDocument[]

  workflowDefinitions WorkflowDefinition[]

  notifications      Notification[]
  companySettings    CompanySettings?
  integrationConfigs IntegrationConfig[]
  auditLogs          AuditLog[]
}

model Department {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  code      String
  parentId  String?
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Department[] @relation("DepartmentHierarchy")
  isActive  Boolean      @default(true)

  employees Employee[]

  jobRequisitions     JobRequisition[]
  onboardingTemplates OnboardingChecklistTemplate[]

  announcements Announcement[]
  recognitions  Recognition[]

  @@unique([companyId, code])
}

model Designation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]

  @@unique([companyId, code])
}

model Grade {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]

  @@unique([companyId, code])
}

model Location {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String
  isActive  Boolean @default(true)

  employees Employee[]
  holidays  Holiday[]

  announcements Announcement[]

  @@unique([companyId, code])
}

model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Employee Code is system-generated, unique, immutable once assigned
  // (Section 7.1 Business Rules) — application layer enforces immutability.
  employeeCode String @unique

  firstName     String
  lastName      String
  dob           DateTime?
  gender        Gender?
  personalEmail String?
  workEmail     String?   @unique
  phone         String?

  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  gradeId            String?
  grade              Grade?       @relation(fields: [gradeId], references: [id])
  locationId         String?
  location           Location?    @relation(fields: [locationId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?    @relation("ManagerReports", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports      Employee[]   @relation("ManagerReports")

  dateOfJoining  DateTime?
  employmentType EmploymentType?
  status         EmployeeStatus  @default(ACTIVE_PROBATION)

  // System role for RBAC (Section 6) — every employee is also a system user.
  role Role @default(EMPLOYEE)

  // Auth Phase 1: bcrypt hash for email+password login. Nullable — most
  // employees are provisioned without one until the later activation/
  // invitation phase; only Super Admin is seeded with a password today.
  passwordHash String?

  // Section 11 Application Security Controls: MFA mandatory for Super
  // Admin/HR Admin. mfaSecret is set (but mfaEnabled stays false) the
  // moment enrollment starts at login, so the same secret backs the QR
  // code shown to the user and the code they immediately submit to
  // confirm it.
  mfaSecret     String?
  mfaEnabled    Boolean        @default(false)
  refreshTokens RefreshToken[]
  trustedDevices TrustedDevice[]

  // Statutory / sensitive fields — masked in API responses per Section 7.1
  // Business Rules unless the requester is HR Admin, Super Admin, or self.
  pan               String?
  aadhaar           String?
  bankAccountNumber String?
  ifscCode          String?

  // Performance Evaluation Policy 2026 / P&B: current annual CTC in Lakhs —
  // determines which CTC band's "Member KPI Linked Rewards" yearly limit
  // (PerformanceService.CTC_BANDS) applies when computing a quarter's KPI
  // reward payout. Nullable — HR sets this after hire; a quarterly reward
  // can't be computed until it is.
  ctcLpa Float?

  bloodGroup BloodGroup?

  // Self-service avatar shown across every dashboard. Stored as a small
  // data: URI (client-side downscaled to a thumbnail before upload) rather
  // than a blob-storage reference — this app has no file-storage backend,
  // and a compressed thumbnail comfortably fits a text column.
  photoUrl String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Auth Phase 3: profile-completion address fields — none of these
  // existed anywhere on Employee before this phase.
  addressLine String?
  city        String?
  state       String?
  country     String?
  postalCode  String?

  documents      EmployeeDocument[]
  historyEntries EmployeeHistory[]
  changeRequests ProfileChangeRequest[]

  rosterEntries              RosterEntry[]
  hybridSchedules            EmployeeHybridSchedule[]
  shiftSwapRequestsRequested ShiftSwapRequest[]         @relation("SwapRequester")
  shiftSwapRequestsReceived  ShiftSwapRequest[]         @relation("SwapCounterpart")
  attendanceRecords          AttendanceRecord[]
  regularizationRequests     RegularizationRequest[]
  overtimeClaims             OvertimeClaim[]
  wfoWfhRequests             WfoWfhChangeRequest[]
  leaveBalances              LeaveBalance[]
  leaveApplications          LeaveApplication[]
  compOffRequests            CompOffRequest[]
  optionalHolidaySelections  OptionalHolidaySelection[]
  superAdminRequestComments  SuperAdminRequestComment[]

  requisitionsAsHiringManager  JobRequisition[]        @relation("RequisitionHiringManager")
  interviewRoundsAsInterviewer InterviewRound[]        @relation("InterviewerRounds")
  onboardingChecklist          OnboardingChecklist?
  preboardingSubmissions       PreboardingSubmission[]

  goals              Goal[]
  reviews            Review[]
  monthlyEvaluations MonthlyEvaluation[]
  assetAssignments   AssetAssignment[]
  assetRequestsMade  AssetRequest[]      @relation("AssetRequester")
  assetRequestsOwned AssetRequest[]      @relation("AssetApprover")
  resignation        Resignation?
  exitInterview      ExitInterview?
  finalSettlement    FinalSettlement?

  ticketsRaised          Ticket[]          @relation("TicketRaisedBy")
  ticketsAssigned        Ticket[]          @relation("TicketAssignedAgent")
  ticketMessages         TicketMessage[]
  ticketSlaPoliciesOwned TicketSlaPolicy[]

  announcementsCreated Announcement[]
  announcementAcks     AnnouncementAck[]
  recognitionsSent     Recognition[]     @relation("RecognitionSender")
  recognitionsReceived Recognition[]     @relation("RecognitionRecipient")

  savedReportsCreated SavedReport[]

  policyDocumentsUploaded PolicyDocument[]
  assistantConversations  AssistantConversation[]

  workflowDefinitionsCreated WorkflowDefinition[]
  approvalRequestsMade       ApprovalRequest[]
  workflowApprovalDecisions  WorkflowApprovalDecision[]

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationLogs        NotificationLog[]
  invitations             EmployeeInvitation[]
  moduleAccessGrants      ModuleAccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([reportingManagerId])
}

// Auth Phase 2: dedicated single-use invitation record — deliberately NOT
// reusing the existing stateless-JWT MagicLinkService (used by ATS/
// Onboarding), since that mechanism has no DB-backed "used" state and stays
// valid for repeated use until it expires. Only tokenHash is stored; the
// raw token goes out in the email link and is never persisted.
model EmployeeInvitation {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// Section 11 Application Security Controls: "short-lived access tokens;
// refresh-token rotation on use." Same shape as EmployeeInvitation above —
// only a hash of the token is stored, never the raw value, so a database
// leak alone can't be replayed as a live session. Each successful
// /auth/refresh revokes the row it was issued from and creates a new one;
// presenting an already-revoked token is a signal of token theft/reuse.
model RefreshToken {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// Section 11: lets a machine that already completed MFA once skip it on
// later logins — only for MFA_REQUIRED_ROLES (HR_ADMIN/SUPER_ADMIN); a
// login from any other machine still has to scan the QR/enter a code.
// Same tokenHash-only-storage shape as RefreshToken, for the same reason:
// a database leak alone can't be replayed as a trusted device.
model TrustedDevice {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([employeeId])
}

model EmployeeDocument {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  docType    String
  fileRef    String
  expiryDate DateTime?
  uploadedBy String
  uploadedAt DateTime  @default(now())

  @@index([employeeId])
}

model EmployeeHistory {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  fieldChanged  String
  oldValue      String?
  newValue      String?
  changedBy     String
  changedAt     DateTime  @default(now())
  effectiveDate DateTime?

  @@index([employeeId])
}

// Employee-submitted profile changes never write directly to the master
// record (Section 7.1 Business Rules) — they land here for HR Admin review.
model ProfileChangeRequest {
  id              String              @id @default(uuid())
  employeeId      String
  employee        Employee            @relation(fields: [employeeId], references: [id])
  fieldName       String
  oldValue        String?
  newValue        String
  status          ChangeRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Shift & Roster Management (Section 7.4)
// ---------------------------------------------------------------------------

enum ShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
}

model Shift {
  id           String  @id @default(uuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  name         String
  // Stored as "HH:mm" — a scaffold-level simplification over full TZ-aware time handling.
  startTime    String
  endTime      String
  graceMinutes Int     @default(0)
  halfDayHours Float   @default(4.5)
  isNightShift Boolean @default(false)

  rosterEntries RosterEntry[]

  @@unique([companyId, name])
}

enum WorkMode {
  OFFICE
  WORK_FROM_HOME
}

model RosterEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  date       DateTime
  isWeekOff  Boolean  @default(false)
  workMode   WorkMode @default(OFFICE)

  @@unique([employeeId, date])
  @@index([employeeId])
}

// Hybrid work culture (Section 7.4): each employee has their own office
// weekdays, assigned by HR per month — not a single company-wide pattern,
// since different employees/teams come in on different days.
model EmployeeHybridSchedule {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  year           Int
  month          Int
  officeWeekdays Int[]

  @@unique([employeeId, year, month])
}

model ShiftSwapRequest {
  id            String          @id @default(uuid())
  requesterId   String
  requester     Employee        @relation("SwapRequester", fields: [requesterId], references: [id])
  counterpartId String
  counterpart   Employee        @relation("SwapCounterpart", fields: [counterpartId], references: [id])
  date          DateTime
  status        ShiftSwapStatus @default(PENDING)
  approverId    String?
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())
}

enum WfoWfhRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Employee-initiated work-mode swap: originalDate -> requestedWorkMode, and
// in exchange compensatoryDate -> the opposite mode (WorkMode only has two
// values, so compensatoryWorkMode is always deterministic — recomputed
// server-side at submit time, never trusted from the client). Approving
// flips RosterEntry.workMode on both dates in one transaction.
model WfoWfhChangeRequest {
  id                   String              @id @default(uuid())
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id])
  originalDate         DateTime
  requestedWorkMode    WorkMode
  compensatoryDate     DateTime
  compensatoryWorkMode WorkMode
  reason               String
  status               WfoWfhRequestStatus @default(PENDING)
  // Loose string, not a Prisma relation — same shape as
  // RegularizationRequest.approverId/ShiftSwapRequest.approverId above.
  approverId           String?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())

  @@index([employeeId])
  @@index([approverId])
}

// ---------------------------------------------------------------------------
// Holiday Calendar (Section 7.5)
// ---------------------------------------------------------------------------

model Holiday {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  year       Int
  date       DateTime
  name       String
  isOptional Boolean  @default(false)

  optionalSelections OptionalHolidaySelection[]

  @@unique([locationId, date])
  @@index([locationId, year])
}

model OptionalHolidaySelection {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  holidayId  String
  holiday    Holiday  @relation(fields: [holidayId], references: [id])
  selectedAt DateTime @default(now())

  @@unique([employeeId, holidayId])
}

// ---------------------------------------------------------------------------
// Attendance Management (Section 7.2)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  EARLY_EXIT
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  WFH
}

enum AttendanceSource {
  BIOMETRIC
  WEB
  MOBILE
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRecord {
  id            String            @id @default(uuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id])
  date          DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  source        AttendanceSource?
  status        AttendanceStatus  @default(ABSENT)
  workHours     Float?
  overtimeHours Float?
  isLocked      Boolean           @default(false)

  @@unique([employeeId, date])
  @@index([employeeId])
}

model RegularizationRequest {
  id              String               @id @default(uuid())
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id])
  date            DateTime
  requestedStatus AttendanceStatus
  reason          String
  evidenceRef     String?
  approverId      String?
  status          RegularizationStatus @default(PENDING)
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([employeeId])
}

// Two-stage approval: the assigned manager (approverId) decides first: a
// reject there is terminal. An approval escalates to PENDING_SUPER_ADMIN,
// where any Super Admin (not just approverId) gives the final decision.
enum OvertimeClaimStatus {
  PENDING_MANAGER
  PENDING_SUPER_ADMIN
  APPROVED
  REJECTED
}

// Employee-initiated claim for overtime worked on a given date. Purely a
// recorded claim — approving/rejecting only flips its own status, no
// AttendanceRecord/LeaveBalance side effect (no auto pay/leave conversion).
model OvertimeClaim {
  id                String              @id @default(uuid())
  employeeId        String
  employee          Employee            @relation(fields: [employeeId], references: [id])
  date              DateTime
  hoursClaimed      Float
  reason            String
  status            OvertimeClaimStatus @default(PENDING_MANAGER)
  approverId        String?
  // Audit trail for the manager stage specifically, since approverId stays
  // put as "who was assigned" while status moves on to PENDING_SUPER_ADMIN —
  // these capture who actually clicked approve and when.
  managerApproverId String?
  managerDecidedAt  DateTime?
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())

  @@index([employeeId])
  @@index([approverId])
}

// ---------------------------------------------------------------------------
// Leave Management (Section 7.3)
// ---------------------------------------------------------------------------

enum LeaveAccrualFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model LeaveType {
  id                        String                @id @default(uuid())
  companyId                 String
  company                   Company               @relation(fields: [companyId], references: [id])
  name                      String
  // Short reference code (e.g. "EL", "SL", "CL") shown alongside the name,
  // consistent with the code convention on Department/Designation/Grade.
  code                      String?
  accrualFrequency          LeaveAccrualFrequency @default(MONTHLY)
  accrualRate               Float                 @default(0)
  maxCarryForward           Float                 @default(0)
  isEncashable              Boolean               @default(false)
  requiresDocumentAfterDays Int?
  allowsNegativeBalance     Boolean               @default(false)
  // Marks the lazily-created per-company "Comp Off" leave type. Comp-off
  // credit is an event-driven +1 (see LeaveService.creditCompOffDay), not a
  // recurring cadence, so it doesn't belong in accrualFrequency's enum —
  // this flag just tells runMonthlyAccrual() to skip these rows outright.
  isCompOff                 Boolean               @default(false)

  balances     LeaveBalance[]
  applications LeaveApplication[]

  @@unique([companyId, name])
}

enum CompOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Employee-initiated claim for a compensatory day off after working a
// holiday/week-off. Approving credits 1 day to the employee's "Comp Off"
// LeaveBalance (see LeaveService.creditCompOffDay) — spendable afterward
// through the normal leave-application flow.
model CompOffRequest {
  id         String               @id @default(uuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id])
  workedDate DateTime
  reason     String
  status     CompOffRequestStatus @default(PENDING)
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime             @default(now())

  @@index([employeeId])
  @@index([approverId])
}

model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  openingBalance Float     @default(0)
  accrued        Float     @default(0)
  used           Float     @default(0)
  carriedForward Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveApplication {
  id                String                 @id @default(uuid())
  employeeId        String
  employee          Employee               @relation(fields: [employeeId], references: [id])
  leaveTypeId       String
  leaveType         LeaveType              @relation(fields: [leaveTypeId], references: [id])
  startDate         DateTime
  endDate           DateTime
  daysCount         Float
  reason            String?
  status            LeaveApplicationStatus @default(PENDING)
  currentApproverId String?

  approvalSteps LeaveApprovalStep[]

  createdAt DateTime @default(now())

  @@index([employeeId])
}

model LeaveApprovalStep {
  id            String           @id @default(uuid())
  applicationId String
  application   LeaveApplication @relation(fields: [applicationId], references: [id])
  approverId    String
  sequence      Int
  decision      ApprovalDecision @default(PENDING)
  decidedAt     DateTime?
  comment       String?
}

// ---------------------------------------------------------------------------
// Recruitment & Applicant Tracking System (Section 7.6)
// ---------------------------------------------------------------------------

enum RequisitionStatus {
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ON_HOLD
  FILLED
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model JobRequisition {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  title           String
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])
  hiringManagerId String
  hiringManager   Employee          @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [id])
  headcount       Int               @default(1)
  status          RequisitionStatus @default(PENDING_APPROVAL)
  approvedBy      String?
  approvedAt      DateTime?
  budgetCtc       Float?
  createdAt       DateTime          @default(now())

  candidates Candidate[]

  @@index([companyId])
}

// Duplicate detection (Section 7.6 Business Rules: "same email/phone within
// 12 months are flagged, not silently created") self-links to the earlier
// record rather than blocking creation.
model Candidate {
  id            String         @id @default(uuid())
  requisitionId String
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id])
  name          String
  email         String
  phone         String?
  resumeRef     String?
  source        String?
  currentStage  CandidateStage @default(APPLIED)
  duplicateOfId String?
  duplicateOf   Candidate?     @relation("CandidateDuplicate", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates    Candidate[]    @relation("CandidateDuplicate")
  appliedAt     DateTime       @default(now())

  interviewRounds InterviewRound[]
  offers          Offer[]

  @@index([requisitionId])
  @@index([email])
}

model InterviewRound {
  id             String    @id @default(uuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  interviewerId  String
  interviewer    Employee  @relation("InterviewerRounds", fields: [interviewerId], references: [id])
  scheduledAt    DateTime
  scorecardJson  Json?
  recommendation String?
  completedAt    DateTime?

  @@index([candidateId])
}

model Offer {
  id             String      @id @default(uuid())
  candidateId    String
  candidate      Candidate   @relation(fields: [candidateId], references: [id])
  ctcBreakupJson Json
  status         OfferStatus @default(DRAFT)

  // Which letter template's subject/body was rendered into the email sent
  // to the candidate — null means the built-in default copy was used
  // (either no templates exist yet, or none was explicitly selected).
  templateId String?
  template   OfferTemplate? @relation(fields: [templateId], references: [id])

  // Business Rule: "requires sign-off from Hiring Manager + HR Admin before
  // the letter is generated/sent" — two independent approvals, not a chain.
  hiringManagerApprovedBy String?
  hiringManagerApprovedAt DateTime?
  hrApprovedBy            String?
  hrApprovedAt            DateTime?

  sentAt            DateTime?
  acceptedAt        DateTime?
  docRef            String?
  createdEmployeeId String?

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([templateId])
}

// HR-customizable offer letter content — subject/body support {{token}}
// placeholders (candidateName, requisitionTitle, ctc, responseLink)
// substituted when the offer is actually sent, rather than a single
// hardcoded email hardcoded into the service.
model OfferTemplate {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  subject   String
  body      String
  // At most one default per company — enforced in the service, not the DB,
  // since "unset every other row's default" is simpler as an application
  // transaction than a partial unique index Prisma can't express directly.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  offers Offer[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Onboarding & Preboarding (Section 7.7)
// ---------------------------------------------------------------------------

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ChecklistTaskStatus {
  PENDING
  COMPLETED
}

enum ChecklistOwnerRole {
  HR
  IT
  MANAGER
  NEW_HIRE
}

// Versioned per Section 7.7 Business Rules ("changing a template doesn't
// retroactively alter checklists already in progress") — OnboardingChecklist
// snapshots templateId at creation and is never re-pointed at a newer version.
model OnboardingChecklistTemplate {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  version      Int         @default(1)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  taskTemplates ChecklistTaskTemplate[]
  checklists    OnboardingChecklist[]
}

model ChecklistTaskTemplate {
  id            String                      @id @default(uuid())
  templateId    String
  template      OnboardingChecklistTemplate @relation(fields: [templateId], references: [id])
  ownerRole     ChecklistOwnerRole
  description   String
  dueOffsetDays Int                         @default(0)

  @@index([templateId])
}

model OnboardingChecklist {
  id         String                      @id @default(uuid())
  employeeId String                      @unique
  employee   Employee                    @relation(fields: [employeeId], references: [id])
  templateId String
  template   OnboardingChecklistTemplate @relation(fields: [templateId], references: [id])
  status     ChecklistStatus             @default(NOT_STARTED)
  createdAt  DateTime                    @default(now())

  tasks ChecklistTask[]
}

model ChecklistTask {
  id          String              @id @default(uuid())
  checklistId String
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id])
  ownerRole   ChecklistOwnerRole
  description String
  dueDate     DateTime?
  status      ChecklistTaskStatus @default(PENDING)
  completedBy String?
  completedAt DateTime?

  @@index([checklistId])
}

model PreboardingSubmission {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  fieldType   String
  valueRef    String
  verifiedBy  String?
  verifiedAt  DateTime?
  submittedAt DateTime  @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Performance Management & Goals/OKRs (Section 7.8)
// ---------------------------------------------------------------------------

enum ReviewCycleStatus {
  DRAFT
  OPEN
  CALIBRATION
  CLOSED
}

// Cadence the cycle's period represents — mirrors LeaveAccrualFrequency's
// MONTHLY/QUARTERLY shape. Quarterly stays the default so existing cycles
// (created before this field existed) and any caller that omits it keep
// behaving exactly as before.
enum ReviewCycleType {
  MONTHLY
  QUARTERLY
  YEARLY
}

// Derived from whether self/manager sections are present — see
// PerformanceService.deriveReviewStatus — so submission order never matters.
enum ReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_CALIBRATION
  FINALIZED
}

model ReviewCycle {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  name        String
  cycleType   ReviewCycleType   @default(QUARTERLY)
  periodStart DateTime
  periodEnd   DateTime
  status      ReviewCycleStatus @default(OPEN)
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime          @default(now())

  goals   Goal[]
  reviews Review[]
}

// Cascades company → department → team → individual via parentGoalId
// (Section 7.8 Key Features).
model Goal {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  cycleId      String
  cycle        ReviewCycle @relation(fields: [cycleId], references: [id])
  parentGoalId String?
  parentGoal   Goal?       @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childGoals   Goal[]      @relation("GoalHierarchy")
  title        String
  target       Float?
  actual       Float       @default(0)
  weightage    Float       @default(0)
  createdAt    DateTime    @default(now())

  @@index([employeeId, cycleId])
}

model Review {
  id                    String       @id @default(uuid())
  cycleId               String
  cycle                 ReviewCycle  @relation(fields: [cycleId], references: [id])
  employeeId            String
  employee              Employee     @relation(fields: [employeeId], references: [id])
  selfAssessmentJson    Json?
  managerAssessmentJson Json?
  finalRating           Float?
  status                ReviewStatus @default(NOT_STARTED)
  version               Int          @default(1)
  finalizedBy           String?
  finalizedAt           DateTime?

  corrections ReviewCorrection[]

  @@unique([cycleId, employeeId])
}

// Section 7.8 Business Rule: "Ratings are locked ... once a cycle is closed;
// further changes require a documented correction workflow" — this is that
// documented trail, distinct from the generic audit log.
model ReviewCorrection {
  id             String   @id @default(uuid())
  reviewId       String
  review         Review   @relation(fields: [reviewId], references: [id])
  previousRating Float?
  newRating      Float
  reason         String
  correctedBy    String
  correctedAt    DateTime @default(now())

  @@index([reviewId])
}

// Performance Evaluation Policy 2026, Section 4 "KPI Score Mapping" — pure
// function of kpiScore, see PerformanceService.computeGrade for the mapping.
enum PerformanceGrade {
  FEE // Far Exceeds Expectations (950-1000)
  EE // Exceeds Expectations (850-949)
  ME // Meets Expectations (700-849)
  PME // Partially Meets Expectations (600-699)
  DNME // Does Not Meet Expectations (<600)
}

// Policy Section 2 "KPI Scoring and Governance": scores are audited by the
// Head of Finance and Company Compliance (mapped here to HR_ADMIN/SUPER_ADMIN
// — there's no dedicated Finance/Compliance role in this system) before they
// count as final; SENT_BACK means the manager must resubmit.
enum EvaluationAuditStatus {
  PENDING_AUDIT
  APPROVED
  SENT_BACK
}

// Policy Section 4 "Performance Evaluation Methodology" — monthly, not tied
// to the (annual/adhoc) ReviewCycle above. Policy Section 7: "Exact KPI
// scores will not be shared with employees ... only final performance grades
// will be communicated" — enforced in PerformanceService, not at the schema
// level, since HR/managers still need the raw score.
model MonthlyEvaluation {
  id            String                @id @default(uuid())
  employeeId    String
  employee      Employee              @relation(fields: [employeeId], references: [id])
  period        DateTime // normalized to the 1st of the evaluated month
  kpiScore      Int
  grade         PerformanceGrade
  justification String
  submittedBy   String
  submittedAt   DateTime              @default(now())
  auditStatus   EvaluationAuditStatus @default(PENDING_AUDIT)
  auditedBy     String?
  auditedAt     DateTime?
  auditNotes    String?
  createdAt     DateTime              @default(now())

  @@unique([employeeId, period])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Asset Management (Section 7.9)
// ---------------------------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  PENDING_HANDOVER
  ISSUED
  IN_REPAIR
  RETIRED
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model Asset {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  category       String
  make           String?
  model          String?
  serialNumber   String?     @unique
  purchaseDate   DateTime?
  cost           Float?
  warrantyExpiry DateTime?
  condition      String      @default("GOOD")
  status         AssetStatus @default(AVAILABLE)
  createdAt      DateTime    @default(now())

  assignments AssetAssignment[]

  @@index([companyId])
}

// Section 7.9 Business Rule: "An asset can only be assigned to one active
// custodian at a time" — active means returnedAt IS NULL. Issuing to a new
// employee auto-closes (sets returnedAt on) the prior open record.
model AssetAssignment {
  id              String    @id @default(uuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  issuedAt        DateTime  @default(now())
  acknowledgedAt  DateTime?
  returnedAt      DateTime?
  returnCondition String?

  @@index([assetId])
  @@index([employeeId])
}

model AssetRequest {
  id            String             @id @default(uuid())
  employeeId    String
  employee      Employee           @relation("AssetRequester", fields: [employeeId], references: [id])
  assetCategory String
  justification String?
  status        AssetRequestStatus @default(PENDING)
  approverId    String?
  approver      Employee?          @relation("AssetApprover", fields: [approverId], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Offboarding — Resignation, Exit, Final Settlement (Section 7.10)
// ---------------------------------------------------------------------------

enum ResignationStatus {
  SUBMITTED
  CLEARANCE_IN_PROGRESS
  CLEARED
  SETTLED
  ARCHIVED
}

// Matches the two sections of the company's actual Separation Clearance
// Checklist: items verified by the Community POC/Lead, vs. items the exiting
// employee self-declares.
enum ClearanceItemCategory {
  LEAD_VERIFICATION
  EMPLOYEE_DECLARATION
}

enum ClearanceStatus {
  PENDING
  SIGNED_OFF
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

model Resignation {
  id                    String            @id @default(uuid())
  employeeId            String            @unique
  employee              Employee          @relation(fields: [employeeId], references: [id])
  submittedDate         DateTime          @default(now())
  noticePeriodDays      Int
  lastWorkingDay        DateTime
  status                ResignationStatus @default(SUBMITTED)
  rehireEligible        Boolean           @default(true)
  relievingLetterRef    String?
  experienceLetterRef   String?
  lettersGeneratedAt    DateTime?
  // "To be filled by Human Resources only" section of the Separation
  // Clearance Checklist — captured when the letters/certificate are released.
  closingRemarks        String?
  certificateReleasedBy String?
  createdAt             DateTime          @default(now())

  clearanceItems  ClearanceItem[]
  lwdAdjustments  LwdAdjustment[]
  exitInterview   ExitInterview?
  finalSettlement FinalSettlement?

  @@index([employeeId])
}

// Section 7.10 Business Rule: "Last working day ... adjustable via mutual
// negotiation with manager+HR Admin sign-off and audit trail" — this row is
// that audit trail; Resignation.lastWorkingDay always reflects the latest.
model LwdAdjustment {
  id            String      @id @default(uuid())
  resignationId String
  resignation   Resignation @relation(fields: [resignationId], references: [id])
  previousDate  DateTime
  newDate       DateTime
  reason        String
  adjustedBy    String
  adjustedAt    DateTime    @default(now())

  @@index([resignationId])
}

// One row per line item of the company's Separation Clearance Checklist
// (e.g. "OFFICE_EQUIPMENT", "ID_CARD", "FORWARDING_ADDRESS") — `key` is the
// stable machine identifier the app branches on (see OffboardingService's
// asset-return gate), `label` is the human wording from the actual document.
model ClearanceItem {
  id            String                @id @default(uuid())
  resignationId String
  resignation   Resignation           @relation(fields: [resignationId], references: [id])
  key           String
  label         String
  category      ClearanceItemCategory
  status        ClearanceStatus       @default(PENDING)
  signedOffBy   String?
  signedOffAt   DateTime?
  remarks       String?

  @@unique([resignationId, key])
}

model ExitInterview {
  id            String      @id @default(uuid())
  resignationId String      @unique
  resignation   Resignation @relation(fields: [resignationId], references: [id])
  employeeId    String      @unique
  employee      Employee    @relation(fields: [employeeId], references: [id])
  responsesJson Json?
  conductedBy   String?
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
}

// Section 7.10 Business Rule: "F&F settlement automatically pulls: unused
// leave balance (Leave module) for encashment, unreturned/damaged asset cost
// (Asset module), and any notice-period shortfall recovery — no manual
// re-entry." OffboardingService.computeSettlement is the single place that
// pulls all three; this row is the persisted, approvable snapshot of that.
model FinalSettlement {
  id              String           @id @default(uuid())
  resignationId   String           @unique
  resignation     Resignation      @relation(fields: [resignationId], references: [id])
  employeeId      String           @unique
  employee        Employee         @relation(fields: [employeeId], references: [id])
  pendingSalary   Float            @default(0)
  leaveEncashment Float            @default(0)
  noticeRecovery  Float            @default(0)
  assetRecovery   Float            @default(0)
  netPayable      Float            @default(0)
  status          SettlementStatus @default(DRAFT)
  computedAt      DateTime         @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
}

// ---------------------------------------------------------------------------
// Helpdesk / HR Ticketing (Section 7.11)
// ---------------------------------------------------------------------------

// Section 7.11 Key Features: "Ticket categories (Payroll query,
// Leave/Attendance issue, IT support, Admin/Facilities, General HR) each
// routable to a specific support queue/agent group" — these five are the
// PRD's literal, fixed list, not an open admin-defined set.
enum TicketCategory {
  PAYROLL_QUERY
  LEAVE_ATTENDANCE_ISSUE
  IT_SUPPORT
  ADMIN_FACILITIES
  GENERAL_HR
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

// Section 7.11 Key Features: "SLA timers per category/priority" — HR
// Admin-configurable per company; helpdesk.service.ts falls back to a
// built-in default (DEFAULT_SLA_HOURS) when no row exists for a given
// category+priority, the same "configurable override, sane built-in
// default" shape OnboardingChecklistTemplate uses for department fallback.
model TicketSlaPolicy {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  category  TicketCategory
  priority  TicketPriority
  slaHours  Int
  // Section 7.11 Business Rule: "SLA breach automatically escalates to the
  // category's designated HR Admin/lead" — this is that designated lead.
  agentId   String?
  agent     Employee?      @relation(fields: [agentId], references: [id])

  @@unique([companyId, category, priority])
}

model Ticket {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("TicketRaisedBy", fields: [employeeId], references: [id])

  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  subject     String
  description String
  status      TicketStatus   @default(OPEN)

  assignedAgentId String?
  assignedAgent   Employee? @relation("TicketAssignedAgent", fields: [assignedAgentId], references: [id])

  // Section 7.11 Workflow: due at creation from the category/priority SLA
  // policy; warning/breach timestamps are set once each by the escalation
  // job so repeated cron runs don't re-notify on every pass.
  slaDueAt             DateTime?
  slaWarningNotifiedAt DateTime?
  slaBreachedAt        DateTime?

  // Section 7.11 Business Rule: "A ticket cannot be closed without a
  // resolution note" — enforced in helpdesk.service.ts at the CLOSED
  // transition.
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  // Section 7.11 Business Rule: "Employees can reopen a closed ticket
  // within a configurable window" — reopenedAt anchors that window's start
  // for any subsequent reopen, and distinguishes a reopened ticket from a
  // fresh one in reporting.
  reopenedAt     DateTime?

  // Section 7.11 Key Features: "CSAT rating request on ticket closure."
  csatRating Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([employeeId])
  @@index([assignedAgentId])
  @@index([status])
}

// Section 7.11 Key Features: "Threaded conversation per ticket with
// attachments and internal-only agent notes" — isInternalNote-flagged rows
// are filtered out before a non-agent/non-HR viewer (the ticket's own
// employee) ever sees them.
model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  senderId String
  sender   Employee @relation(fields: [senderId], references: [id])

  body           String
  isInternalNote Boolean @default(false)
  // Scaffold-level simplification matching EmployeeDocument.fileRef — a
  // reference to wherever the attachment is actually stored, not a real
  // upload pipeline.
  attachmentRef  String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Section 7.11 Key Features: "Searchable FAQ/knowledge-base surfaced to
// employees before they raise a ticket (deflection)."
model FaqEntry {
  id        String          @id @default(uuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  category  TicketCategory?
  question  String
  answer    String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Announcements & Recognition (Section 7.12)
// ---------------------------------------------------------------------------

// Section 7.12 Key Feature: "Target employees by organization, department,
// or location."
enum AnnouncementScope {
  ORGANIZATION
  DEPARTMENT
  LOCATION
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecognitionCategory {
  TEAMWORK
  INNOVATION
  CUSTOMER_FOCUS
}

model Announcement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  title     String
  body      String

  scope        AnnouncementScope
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  locationId   String?
  location     Location?         @relation(fields: [locationId], references: [id])

  priority AnnouncementPriority @default(MEDIUM)
  isPinned Boolean              @default(false)

  // Section 7.12 Business Rule: "Mandatory announcements track per-employee
  // acknowledgement/read status" — AnnouncementAck rows are only created
  // (one per targeted employee) when this is true.
  requiresAck Boolean @default(false)

  createdBy String
  creator   Employee @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  acks AnnouncementAck[]

  @@index([companyId])
  @@index([departmentId])
  @@index([locationId])
}

// Section 7.12 Acceptance Criteria: "Mandatory announcement compliance
// accurately reflects per-employee read status" — one row per targeted
// employee, pre-created at announcement-creation time so compliance-% is a
// simple count query rather than an approximation (same shape as
// OnboardingChecklist/ChecklistTask).
model AnnouncementAck {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime?
  // Idempotency marker for the T+2 reminder cron — set once so a later
  // sweep doesn't re-notify.
  remindedAt     DateTime?

  @@unique([announcementId, employeeId])
  @@index([employeeId])
}

// Section 7.12 Key Feature: "Recognition can optionally be restricted to a
// department" — when set, only that department's employees (plus HR
// Admin/Super Admin) see this entry in the feed; null means public kudos
// visible to everyone.
model Recognition {
  id           String              @id @default(uuid())
  senderId     String
  sender       Employee            @relation("RecognitionSender", fields: [senderId], references: [id])
  recipientId  String
  recipient    Employee            @relation("RecognitionRecipient", fields: [recipientId], references: [id])
  message      String
  category     RecognitionCategory
  departmentId String?
  department   Department?         @relation(fields: [departmentId], references: [id])
  createdAt    DateTime            @default(now())

  @@index([recipientId])
  @@index([departmentId])
}

enum ReportSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

// Section 7.14 Business Rule: "Policy answers must be grounded in indexed
// company documents." No vector DB exists in this stack — `content` is
// searched via a plain keyword-relevance scan rather than embeddings; a
// real semantic-search upgrade can swap the retrieval method later without
// touching this shape.
model PolicyDocument {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  title   String
  content String
  version Int    @default(1)

  uploadedById String
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id])

  indexedAt DateTime @default(now())

  @@index([companyId])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

// Section 7.14: "Full conversation logging for audit" — this table IS the
// audit trail for assistant interactions (Section 7.18's general audit log
// doesn't exist yet); every action the assistant takes is recorded here
// against the real employee's id, never a system identity.
model AssistantConversation {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  messages AssistantMessage[]

  @@index([employeeId])
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id])

  role    AssistantMessageRole
  message String

  // Cited PolicyDocument ids/titles the answer was grounded in — empty for
  // a data/action query or an honest "I don't have this" refusal.
  groundedSources Json?

  // Set on an assistant message that proposes a write action, awaiting the
  // user's explicit confirmation; cleared (moved into actionTaken) once
  // executed. AC: "never executes a write action without confirmation."
  proposedAction Json?
  actionTaken    Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// Section 7.13 Phase 5 Architecture Decision: SavedReport persists ONLY for
// scheduled reports (ad-hoc report-builder runs are never stored) — a
// minimal config+schedule+recipients record. Recipients are re-validated
// against their CURRENT role by the cron at send time (AC-3), never trusted
// from what was true when the schedule was created.
model SavedReport {
  id   String @id @default(uuid())
  name String

  // The exact BuildReportDto payload (entity/fields/filters/groupBy) to
  // re-run on every scheduled send.
  config Json

  schedule     ReportSchedule
  recipientIds Json // string[] of Employee ids

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  lastRunAt DateTime?
  createdAt DateTime  @default(now())

  @@index([schedule])
}

// Section 7.15 Architecture Decision: a generic, configurable approval
// engine — `stepsJson` holds an ordered WorkflowStepDef[] (approver rule(s),
// requireAll for parallel steps, per-step SLA/escalation, optional numeric
// condition for conditional branching). See workflow-types.ts for the exact
// shape. Reuses the existing `ApprovalDecision` enum (PENDING/APPROVED/
// REJECTED) for both request-level status and per-decision outcome, rather
// than adding a near-duplicate enum.
model WorkflowDefinition {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name      String
  module    String // free-text source-module tag, e.g. "LEAVE", "OFFBOARDING"
  stepsJson Json

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  requests ApprovalRequest[]

  @@index([companyId])
}

// Section 7.15: "A generic 'Approval Request' object every module creates
// against a workflow definition" — sourceModule/sourceRecordId let the
// unified inbox and any future module-side listener trace back to the
// originating record without a hard FK (the source record can live in any
// module's table).
model ApprovalRequest {
  id                 String             @id @default(uuid())
  workflowId         String
  workflowDefinition WorkflowDefinition @relation(fields: [workflowId], references: [id])

  sourceModule   String
  sourceRecordId String

  requestedById String
  requestedBy   Employee @relation(fields: [requestedById], references: [id])

  // Numeric/string context used to evaluate step conditions (e.g.
  // {"daysCount": 12}) — Section 7.15 Key Feature: conditional branching.
  contextJson Json

  status      ApprovalDecision @default(PENDING)
  currentStep Int              @default(0)

  // Business Rule: "A step's SLA clock starts only once it becomes the
  // active step" — reset on every advance; escalatedAt prevents re-notifying
  // on every cron pass once a breach has already been flagged once.
  currentStepStartedAt   DateTime  @default(now())
  currentStepEscalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions WorkflowApprovalDecision[]

  @@index([workflowId])
  @@index([status])
  @@index([requestedById])
}

model WorkflowApprovalDecision {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])

  step       Int
  approverId String
  approver   Employee @relation(fields: [approverId], references: [id])

  decision ApprovalDecision
  comment  String?

  decidedAt DateTime @default(now())

  @@index([requestId])
}

enum RequestCommentType {
  WFO_WFH_CHANGE
  COMP_OFF
  OVERTIME
}

// Super Admin oversight comment directed at the assigned manager, never
// visible to the requesting employee. requestType/requestId is a loose
// reference (not a hard FK) — same generic-linkage idea as
// ApprovalRequest's sourceModule/sourceRecordId above, letting one row shape
// work across all three request tables without a polymorphic FK.
model SuperAdminRequestComment {
  id          String             @id @default(uuid())
  requestType RequestCommentType
  requestId   String
  authorId    String
  author      Employee           @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime           @default(now())

  @@index([requestType, requestId])
}

// ---------------------------------------------------------------------------
// Notifications (Section 7.16)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SLACK
  SMS
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

// Section 7.16 Objective: "single shared notification service consumed by
// every module" — this is the in-app inbox row every module's
// NotificationService.send() call ultimately creates one of, alongside a
// NotificationLog entry per channel dispatched.
model Notification {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Opaque catalog key emitted by the calling module, e.g. "leave.decision-made".
  template String
  title    String
  body     String
  data     Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([employeeId, createdAt])
  @@index([employeeId, readAt])
}

// Section 7.16 Business Rule: "per-employee, per-event-category opt-out,
// except security/compliance-critical events which always deliver via email
// regardless of preference" — the critical-event allowlist is enforced in
// NotificationsService, not modeled here; absence of a row for a category
// means all channels are enabled (opt-out, not opt-in).
model NotificationPreference {
  id              String                @id @default(uuid())
  employeeId      String
  employee        Employee              @relation(fields: [employeeId], references: [id])
  eventCategory   String
  channelsEnabled NotificationChannel[]

  @@unique([employeeId, eventCategory])
}

// Section 7.16 Reports: "delivery success/failure rate by channel;
// notification volume by event type" — one row per channel dispatched per
// notification, so one channel's failure (e.g. a Slack webhook down) never
// blocks delivery on another (Section 7.16 Workflow).
model NotificationLog {
  id         String                     @id @default(uuid())
  employeeId String
  employee   Employee                   @relation(fields: [employeeId], references: [id])
  template   String
  channel    NotificationChannel
  status     NotificationDeliveryStatus @default(SENT)
  error      String?
  createdAt  DateTime                   @default(now())

  @@index([employeeId, createdAt])
  @@index([template])
}

// ---------------------------------------------------------------------------
// Settings & Integrations (Section 7.17)
// ---------------------------------------------------------------------------

enum IntegrationType {
  GOOGLE_SSO
  SLACK
  SMS_GATEWAY
  EMAIL_GATEWAY
  BIOMETRIC
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  ERROR
}

// Section 7.17 Data Entities: "CompanySettings (company_id, name, branding_json,
// timezone, fiscal_year_start)" — one row per company; Company.name stays the
// canonical legal name, this table holds the operational/branding config
// Super Admin edits from the Settings screen.
model CompanySettings {
  id                   String   @id @default(uuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id])
  logoUrl              String?
  primaryColor         String?
  timezone             String   @default("Asia/Kolkata")
  fiscalYearStartMonth Int      @default(4)
  updatedAt            DateTime @updatedAt
}

// Section 7.17 Data Entities: "IntegrationConfig (integration_id, type,
// credentials_ref, status)" — metadata holds non-secret labels only (e.g. a
// webhook URL, tenant domain); this app has no OAuth/SMTP/SMS SDK installed,
// so `status` tracks intent/readiness rather than a real connection handshake.
model IntegrationConfig {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  type      IntegrationType
  status    IntegrationStatus @default(NOT_CONFIGURED)
  metadata  Json?
  updatedAt DateTime          @updatedAt

  @@unique([companyId, type])
}

// ---------------------------------------------------------------------------
// Audit Logs & Compliance (Section 7.18)
// ---------------------------------------------------------------------------

// Section 7.18 Acceptance Criteria: "no update or delete API exists for audit
// records, even for Super Admin" — append-only; AuditInterceptor is the only
// writer (both success and failure paths), AuditController is read-only.
// requestBody/responseBody stand in for the PRD's "before_json/after_json"
// since the interceptor has no access to prior entity state — a full
// before/after diff would require instrumenting every service individually.
model AuditLog {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  actorId      String?
  actorRole    String?
  method       String
  path         String
  module       String
  statusCode   Int?
  requestBody  Json?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorId])
  @@index([module])
}

// ---------------------------------------------------------------------------
// Auth Phase 5: Roles & Permissions administration.
// Reuses the existing `Role` enum directly rather than introducing a
// separate Roles table — RolePermission.role stores one of the four
// existing enum values. This catalog is administrative only for now: it is
// not yet consulted by any existing module's authorization checks (those
// remain governed by @Roles()/RolesGuard), so future phases can adopt it
// without a breaking change.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

// This task (Super Admin per-employee module access): a targeted exception
// to a specific employee's role-based access, scoped to one module — e.g.
// letting a MANAGER use Assets without promoting them to HR_ADMIN. Actually
// enforced (unlike the Permission/RolePermission catalog above): RolesGuard
// checks this whenever a route is tagged with @RequiresModule() and the
// caller's own role doesn't already satisfy @Roles(). `module` is a plain
// string key (see MODULE_KEY values in module-access.service.ts), not an
// FK, since it names a route-group tag, not a persisted entity.
model ModuleAccessGrant {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  module     String
  grantedBy  String
  grantedAt  DateTime @default(now())

  @@unique([employeeId, module])
  @@index([employeeId])
}
